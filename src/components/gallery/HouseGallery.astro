---
/**
 * HouseGallery.astro
 *
 * Desktop : large hero image + horizontal thumbnail strip (max 5) + "View all" button
 * Mobile  : swipeable carousel with overlay arrows + "View all" button
 * Expanded: inline thumbnail grid for visual photo selection
 * Fullscreen lightbox remains available from the main image
 *
 * Performance:
 *   - Hero: blur-up placeholder (480px blurred via CSS) + full image fades in on load
 *   - This gallery sits below the page hero, so all of its images load lazily
 *
 * Props
 *   images   – GalleryImage[] already sorted (use sortGalleryImages before passing)
 *   unitName – used for aria-labels and captions
 */
import type { GalleryImage } from "../../types";
import { defaultLocale, type Locale } from "../../i18n/config";
import { getCommonCopy } from "../../i18n/translate";
import { buildGalleryItems, filenameLabel, localizedAlt, placeholderSrc } from "../../utils/galleryHelpers";

interface Props {
  images: GalleryImage[];
  unitName: string;
  /** Active locale, passed explicitly by the page renderer. */
  locale?: Locale;
}

const { images, unitName, locale = defaultLocale } = Astro.props;
const galleryCopy = getCommonCopy(locale).ui.gallery;

if (images.length === 0) return;

// ── Derived image references ────────────────────────────────────────────────
const hero = images[0];
const thumbImages = images.slice(1, 6); // up to 5 thumbnails
const total = images.length;

// Smallest srcset entry used as a CSS-blurred placeholder while hero loads.
// Falls back to hero.src if srcset is missing.
const hero480 = hero.srcset ? placeholderSrc(hero.srcset) : hero.src;

// Unique prefix so multiple gallery instances on one page never clash
const uid =
  "hg-" +
  unitName
    .toLowerCase()
    .replace(/[^a-z0-9]/g, "")
    .slice(0, 12);

// Serialise for the client-side lightbox script
const numberedPhoto = (n: number) => galleryCopy.photoNumbered.replace("{n}", String(n));
const photoOfNumbered = (name: string, n: number) =>
  galleryCopy.photoOfNumbered.replace("{name}", name).replace("{n}", String(n));

const galleryItems = buildGalleryItems(images, unitName, locale);
const galleryClientLabels = {
  hidePhotoGallery: galleryCopy.hidePhotoGallery,
  viewAllPhotos: galleryCopy.viewAllPhotos,
  hidePhotos: galleryCopy.hidePhotos,
  viewAll: galleryCopy.viewAll,
  photos: galleryCopy.photos,
};
---

{
  /* ═══════════════════════════════════════════════
    DESKTOP  (md and up)
    ═══════════════════════════════════════════════ */
}
<section class="mb-10 hidden md:block" aria-label={galleryCopy.photosOf.replace("{name}", unitName)}>
  {/* ── Hero button ────────────────────────────────────────────── */}
  <button
    id={`${uid}-hero`}
    class="group relative block w-full overflow-hidden rounded-2xl bg-stone-200 cursor-pointer
           focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-stone-400"
    style="aspect-ratio:16/9; max-height:65vh;"
    data-lb={uid}
    data-lb-idx="0"
    aria-label={galleryCopy.viewPhoto.replace("{label}", galleryItems[0].label)}
  >
    {
      /*
      Blur-up placeholder:
        - The 480px image loads near-instantly (it's tiny)
        - CSS blur + scale-110 hides the pixellation
        - The full-resolution img fades in over the top once loaded
        - aria-hidden so screen readers skip the duplicate
    */
    }
    <img
      id={`${uid}-hero-placeholder`}
      src={hero480}
      aria-hidden="true"
      alt=""
      class="absolute inset-0 w-full h-full object-cover scale-110 blur-xl pointer-events-none"
      loading="lazy"
      fetchpriority="low"
      decoding="async"
    />

    {
      /*
      Full hero image:
        - Starts opacity-0, fades to opacity-1 via inline onload handler
        - Wrapped in a div so the group-hover scale transform is isolated
          from the opacity transition (two CSS properties on one element
          would share the same transition-duration)
    */
    }
    <div
      class="absolute inset-0 transition-transform duration-[10s] ease-out group-hover:scale-105 will-change-transform"
    >
      <img
        id={`${uid}-hero-img`}
        src={hero.src}
        srcset={hero.srcset}
        sizes="(min-width:1280px) 900px, (min-width:1024px) 66vw, 100vw"
        alt={localizedAlt(hero.src, hero.alt, galleryCopy.mainViewOf.replace("{name}", unitName), locale)}
        class="w-full h-full object-cover"
        style="opacity:0; transition:opacity 0.7s ease;"
        onload="this.style.opacity='1'"
        loading="lazy"
        fetchpriority="low"
        decoding="async"
      />
    </div>

    <div
      class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500 z-10 pointer-events-none"
    >
    </div>

    {/* Counter badge */}
    <span
      id={`${uid}-hero-count`}
      class="absolute bottom-3 right-3 z-20 px-2.5 py-1 rounded-full bg-black/50 text-white text-[11px] font-medium tabular-nums backdrop-blur-sm pointer-events-none"
    >
      1 / {total}
    </span>
  </button>

  <p
    class="mt-3 mb-4 text-center text-sm md:text-base text-stone-600 font-light leading-relaxed font-serif italic"
    data-gallery-main-caption={uid}
  >
    {galleryItems[0].label}
  </p>

  {/* ── Thumbnail strip + "View all" ─────────────────────────── */}
  {
    total > 1 && (
      <div class="mt-2 flex items-stretch gap-2">
        {thumbImages.map((img, i) => (
          <button
            type="button"
            class="group relative flex-1 min-w-0 overflow-hidden rounded-xl bg-stone-200 cursor-pointer
                 border-2 border-transparent hover:border-stone-400
                 focus-visible:border-stone-700 focus-visible:outline-none
                 transition-all duration-150"
            style="aspect-ratio:4/3;"
            data-gallery-select={uid}
            data-gallery-idx={i + 1}
            aria-label={galleryCopy.selectPhoto.replace(
              "{label}",
              filenameLabel(img.src, img.alt ?? numberedPhoto(i + 2), locale),
            )}
          >
            <img
              src={img.src}
              srcset={img.srcset}
              sizes="(min-width:1024px) 12vw, 20vw"
              alt={localizedAlt(img.src, img.alt, photoOfNumbered(unitName, i + 2), locale)}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/15 transition-colors duration-300 pointer-events-none" />
            <span class="gallery-label-overlay absolute inset-x-0 bottom-0 z-10 px-3 py-2 text-left text-[11px] font-medium leading-tight text-white opacity-0 transition-opacity duration-200 pointer-events-none group-hover:opacity-100 group-focus-visible:opacity-100">
              {filenameLabel(img.src, img.alt ?? numberedPhoto(i + 2), locale)}
            </span>
            <span class="gallery-selected-indicator absolute inset-0 bg-stone-950/0 transition-colors duration-150 pointer-events-none" />
          </button>
        ))}

        {/* "View all" tile */}
        <button
          type="button"
          class="shrink-0 flex flex-col items-center justify-center gap-1.5 px-5
               rounded-xl gallery-view-all-cta"
          data-gallery-toggle={uid}
          aria-expanded="false"
          aria-controls={`${uid}-all-photos`}
          aria-label={galleryCopy.viewAllOf.replace("{count}", String(total)).replace("{photos}", galleryCopy.photos).replace("{name}", unitName)}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z" />
          </svg>
          <span
            class="text-[10px] font-bold uppercase tracking-widest leading-tight whitespace-nowrap"
            data-gallery-toggle-label
          >
            {galleryCopy.viewAll}
            <br />
            {galleryCopy.photos}
          </span>
        </button>
      </div>
    )
  }
</section>

{
  /* ═══════════════════════════════════════════════
    MOBILE  (below md)
    ═══════════════════════════════════════════════ */
}
<section class="mb-8 md:hidden" aria-label={galleryCopy.photosOf.replace("{name}", unitName)}>
  {/* Carousel wrapper */}
  <div
    class="relative overflow-hidden rounded-2xl bg-stone-200"
    style="aspect-ratio:4/3;"
  >
    {/* Track */}
    <div
      id={`${uid}-track`}
      class="flex h-full transition-transform duration-300 ease-out will-change-transform"
    >
      {
        images.map((img, i) => (
          <div
            class="shrink-0 w-full h-full cursor-pointer"
            data-lb={uid}
            data-lb-idx={i}
            role="button"
            tabindex={i === 0 ? "0" : "-1"}
            aria-label={galleryCopy.viewPhoto.replace("{label}", galleryItems[i].label)}
          >
            <img
              src={img.src}
              srcset={img.srcset}
              sizes="100vw"
              alt={localizedAlt(img.src, img.alt, photoOfNumbered(unitName, i + 1), locale)}
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>

    {/* Overlay arrows */}
    {
      total > 1 && (
        <>
          <button
            id={`${uid}-mprev`}
            class="absolute left-2 top-1/2 -translate-y-1/2 z-10
                 w-9 h-9 flex items-center justify-center
                 rounded-full bg-black/40 text-white backdrop-blur-sm
                 hover:bg-black/60 transition-colors"
            aria-label={galleryCopy.previousPhoto}
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </button>
          <button
            id={`${uid}-mnext`}
            class="absolute right-2 top-1/2 -translate-y-1/2 z-10
                 w-9 h-9 flex items-center justify-center
                 rounded-full bg-black/40 text-white backdrop-blur-sm
                 hover:bg-black/60 transition-colors"
            aria-label={galleryCopy.nextPhoto}
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
        </>
      )
    }

    {/* Counter */}
    <span
      id={`${uid}-mcount`}
      class="absolute bottom-2 right-3 z-10 px-2 py-0.5 rounded-full bg-black/50 text-white text-[11px] tabular-nums backdrop-blur-sm pointer-events-none"
    >
      1 / {total}
    </span>
  </div>

  {/* View all button */}
  {
    total > 1 && (
      <button
        type="button"
        class="mt-2 w-full flex items-center justify-center gap-2 py-3
             gallery-view-all-cta rounded-xl
             text-[11px] font-bold uppercase tracking-widest"
        data-gallery-toggle={uid}
        aria-expanded="false"
        aria-controls={`${uid}-all-photos`}
        aria-label={galleryCopy.viewAllOf.replace("{count}", String(total)).replace("{photos}", galleryCopy.photos).replace("{name}", unitName)}
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z" />
        </svg>
        <span data-gallery-toggle-label>{galleryCopy.viewAllPhotos}</span>
      </button>
    )
  }
  <p
    class="mt-3 text-center text-sm text-stone-600 font-light leading-relaxed font-serif italic"
    data-gallery-main-caption={uid}
  >
    {galleryItems[0].label}
  </p>
</section>

{
  total > 1 && (
    <section
      id={`${uid}-all-photos`}
      class="mb-12 mt-8"
      aria-labelledby={`${uid}-gallery-heading`}
      hidden
    >
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h2
          id={`${uid}-gallery-heading`}
          class="font-serif text-3xl text-stone-950"
        >
          {galleryCopy.photoGallery}
        </h2>
        <p class="text-xs text-stone-500 tabular-nums">{total} {galleryCopy.photos}</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3">
        {images.map((img, i) => (
          <button
            type="button"
            class="group relative overflow-hidden rounded-xl bg-stone-200 cursor-pointer
                 border-2 border-transparent hover:border-stone-400
                 focus-visible:border-stone-700 focus-visible:outline-none
                 transition-all duration-150"
            style="aspect-ratio:4/3;"
            data-gallery-select={uid}
            data-gallery-idx={i}
            aria-label={galleryCopy.selectPhoto.replace("{label}", galleryItems[i].label)}
            aria-current={i === 0 ? "true" : undefined}
          >
            <img
              src={img.src}
              srcset={img.srcset}
              sizes="(min-width:1280px) 22vw, (min-width:768px) 30vw, 50vw"
              alt={localizedAlt(img.src, img.alt, photoOfNumbered(unitName, i + 1), locale)}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <span class="gallery-label-overlay absolute inset-x-0 bottom-0 z-10 px-3 py-2 text-left text-[11px] font-medium leading-tight text-white opacity-0 transition-opacity duration-200 pointer-events-none group-hover:opacity-100 group-focus-visible:opacity-100">
              {galleryItems[i].label}
            </span>
            <span class="gallery-selected-indicator absolute inset-0 bg-stone-950/0 transition-colors duration-150 pointer-events-none" />
          </button>
        ))}
      </div>
    </section>
  )
}

{
  /* ═══════════════════════════════════════════════
    LIGHTBOX
    ═══════════════════════════════════════════════ */
}
<dialog
  id={`${uid}-lb`}
  class="fixed inset-0 w-full h-full max-w-none max-h-none m-0 p-0 border-none
         bg-stone-950 text-white overflow-hidden"
  style="background-color:#09090b;"
  aria-modal="true"
  aria-label={`${unitName} — ${galleryCopy.photoViewer}`}
>
  <div class="w-full h-full flex flex-col">
    {/* Top bar */}
    <div
      class="flex items-center justify-between px-5 py-3 shrink-0 border-b border-white/10"
    >
      <span
        id={`${uid}-counter`}
        class="font-serif text-sm tracking-widest text-white/60 tabular-nums"
      ></span>
      <button
        id={`${uid}-close`}
        class="w-10 h-10 flex items-center justify-center rounded-full
               bg-stone-700 hover:bg-stone-500 transition-colors"
        style="color:#ffffff;"
        aria-label={galleryCopy.closeViewer}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#ffffff"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line>
        </svg>
      </button>
    </div>

    {/* Image + arrows */}
    <div
      class="relative flex-1 flex flex-col items-center justify-center min-h-0 px-20 py-6"
    >
      {/* PREV */}
      <button
        id={`${uid}-prev`}
        class="absolute left-4 z-20
               w-12 h-12 flex items-center justify-center
               rounded-full bg-white text-stone-900 shadow-2xl
               hover:scale-105 active:scale-95 transition-transform"
        aria-label={galleryCopy.previousPhoto}
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="flex min-h-0 flex-1 items-center justify-center">
        <img
          id={`${uid}-img`}
          src=""
          alt=""
          class="max-h-full max-w-full object-contain select-none rounded-md shadow-2xl"
        />
      </div>

      {/* Caption */}
      <p
        id={`${uid}-caption`}
        class="mt-4 max-w-3xl text-center text-base md:text-lg text-white/85 px-8 shrink-0 font-serif italic leading-relaxed"
      >
      </p>

      {/* NEXT */}
      <button
        id={`${uid}-next`}
        class="absolute right-4 z-20
               w-12 h-12 flex items-center justify-center
               rounded-full bg-white text-stone-900 shadow-2xl
               hover:scale-105 active:scale-95 transition-transform"
        aria-label={galleryCopy.nextPhoto}
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</dialog>

{
  /* ═══════════════════════════════════════════════
    CLIENT SCRIPT  (is:inline so define:vars works)
    ═══════════════════════════════════════════════ */
}
<script is:inline define:vars={{ uid, galleryItems, galleryClientLabels }}>
  (function () {
    var total = galleryItems.length;
    var selectedIdx = 0;

    function normaliseIndex(n) {
      return ((n % total) + total) % total;
    }

    function setResponsiveSource(img, item) {
      if (!img || !item) return;
      img.src = item.src;
      if (item.srcset) {
        img.srcset = item.srcset;
      } else {
        img.removeAttribute("srcset");
      }
      img.alt = item.alt;
    }

    function placeholderFromSrcset(srcset) {
      var first = (srcset || "").split(",")[0];
      var parts = first ? first.trim().split(/\s+/) : [];
      return parts[0] || "";
    }

    var heroButton = document.getElementById(uid + "-hero");
    var heroImg = document.getElementById(uid + "-hero-img");
    var heroPlaceholder = document.getElementById(uid + "-hero-placeholder");
    var heroCount = document.getElementById(uid + "-hero-count");
    var mainCaptions = document.querySelectorAll(
      '[data-gallery-main-caption="' + uid + '"]',
    );
    var track = document.getElementById(uid + "-track");
    var mCount = document.getElementById(uid + "-mcount");
    var mPrev = document.getElementById(uid + "-mprev");
    var mNext = document.getElementById(uid + "-mnext");
    var allPhotos = document.getElementById(uid + "-all-photos");
    var toggles = document.querySelectorAll(
      '[data-gallery-toggle="' + uid + '"]',
    );
    var selectButtons = document.querySelectorAll(
      '[data-gallery-select="' + uid + '"]',
    );

    function syncSelectionButtons() {
      selectButtons.forEach(function (button) {
        var buttonIdx = parseInt(
          button.getAttribute("data-gallery-idx") || "0",
          10,
        );
        if (buttonIdx === selectedIdx) {
          button.setAttribute("aria-current", "true");
        } else {
          button.removeAttribute("aria-current");
        }
      });
    }

    function syncMobileTrack() {
      if (!track) return;
      track.style.transform = "translateX(-" + selectedIdx * 100 + "%)";
      Array.prototype.forEach.call(track.children, function (child, i) {
        child.setAttribute("tabindex", i === selectedIdx ? "0" : "-1");
      });
      if (mCount) mCount.textContent = selectedIdx + 1 + " / " + total;
    }

    function scrollToMainGallery() {
      var target = window.matchMedia("(min-width: 768px)").matches
        ? heroButton
        : track;
      if (target)
        target.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function selectPhoto(n, options) {
      if (total === 0) return;
      selectedIdx = normaliseIndex(n);
      var item = galleryItems[selectedIdx];

      setResponsiveSource(heroImg, item);
      if (heroPlaceholder) {
        heroPlaceholder.src = placeholderFromSrcset(item.srcset) || item.src;
      }
      if (heroButton) {
        heroButton.setAttribute("data-lb-idx", String(selectedIdx));
        heroButton.setAttribute("aria-label", "View " + item.label);
      }
      if (heroCount) heroCount.textContent = selectedIdx + 1 + " / " + total;
      mainCaptions.forEach(function (caption) {
        caption.textContent = item.label;
      });

      syncSelectionButtons();
      syncMobileTrack();

      if (options && options.scrollToMain) scrollToMainGallery();
    }

    function setExpanded(expanded) {
      if (!allPhotos) return;
      allPhotos.hidden = !expanded;
      toggles.forEach(function (toggle) {
        var label = toggle.querySelector("[data-gallery-toggle-label]");
        toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
        toggle.setAttribute(
          "aria-label",
          expanded ? galleryClientLabels.hidePhotoGallery : galleryClientLabels.viewAll + " " + total + " " + galleryClientLabels.photos,
        );
        if (label) {
          label.innerHTML = window.matchMedia("(min-width: 768px)").matches
            ? expanded
              ? galleryClientLabels.hidePhotos.replace(" ", "<br>")
              : galleryClientLabels.viewAll + "<br>" + galleryClientLabels.photos
            : expanded
              ? galleryClientLabels.hidePhotos
              : galleryClientLabels.viewAllPhotos;
        }
      });
      if (expanded) {
        allPhotos.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    toggles.forEach(function (toggle) {
      toggle.addEventListener("click", function () {
        setExpanded(allPhotos ? allPhotos.hidden : false);
      });
    });

    selectButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        selectPhoto(
          parseInt(button.getAttribute("data-gallery-idx") || "0", 10),
          {
            scrollToMain: true,
          },
        );
      });
    });

    /* ── Lightbox ──────────────────────────────── */
    var lb = document.getElementById(uid + "-lb");
    var lbImg = document.getElementById(uid + "-img");
    var lbCap = document.getElementById(uid + "-caption");
    var lbCount = document.getElementById(uid + "-counter");
    var idx = 0;

    function lbShow(n) {
      if (!lb || !lbImg || total === 0) return;
      idx = (n + total) % total;
      var item = galleryItems[idx];
      lbImg.src = item.src;
      lbImg.srcset = item.srcset || "";
      lbImg.alt = item.alt;
      if (lbCap) lbCap.textContent = item.label;
      if (lbCount) lbCount.textContent = idx + 1 + " / " + total;
      selectPhoto(idx, { scrollToMain: false });
    }

    function lbOpen(n) {
      lbShow(n);
      lb.showModal();
      document.body.style.overflow = "hidden";
    }

    function lbClose() {
      lb.close();
      document.body.style.overflow = "";
    }

    /* Triggers — any element with data-lb matching uid */
    document.querySelectorAll('[data-lb="' + uid + '"]').forEach(function (el) {
      el.addEventListener("click", function () {
        lbOpen(parseInt(el.getAttribute("data-lb-idx") || "0", 10));
      });
      el.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          lbOpen(parseInt(el.getAttribute("data-lb-idx") || "0", 10));
        }
      });
    });

    var closeButton = document.getElementById(uid + "-close");
    var prevButton = document.getElementById(uid + "-prev");
    var nextButton = document.getElementById(uid + "-next");

    if (closeButton) closeButton.addEventListener("click", lbClose);

    if (prevButton) {
      prevButton.addEventListener("click", function (e) {
        e.stopPropagation();
        lbShow(idx - 1);
      });
    }

    if (nextButton) {
      nextButton.addEventListener("click", function (e) {
        e.stopPropagation();
        lbShow(idx + 1);
      });
    }

    if (lb)
      lb.addEventListener("click", function (e) {
        if (e.target === lb) lbClose();
      });

    document.addEventListener("keydown", function (e) {
      if (!lb || !lb.open) return;
      if (e.key === "Escape") lbClose();
      if (e.key === "ArrowLeft") lbShow(idx - 1);
      if (e.key === "ArrowRight") lbShow(idx + 1);
    });

    /* Touch swipe in lightbox */
    var lbTx = 0;
    if (lb) {
      lb.addEventListener(
        "touchstart",
        function (e) {
          lbTx = e.changedTouches[0].clientX;
        },
        { passive: true },
      );
      lb.addEventListener(
        "touchend",
        function (e) {
          var dx = e.changedTouches[0].clientX - lbTx;
          if (Math.abs(dx) > 60) dx > 0 ? lbShow(idx - 1) : lbShow(idx + 1);
        },
        { passive: true },
      );
    }

    function mSlide(n) {
      selectPhoto(n, { scrollToMain: false });
    }

    if (mPrev)
      mPrev.addEventListener("click", function (e) {
        e.stopPropagation();
        mSlide(selectedIdx - 1);
      });
    if (mNext)
      mNext.addEventListener("click", function (e) {
        e.stopPropagation();
        mSlide(selectedIdx + 1);
      });

    /* Touch swipe on mobile track */
    var mTx = 0;
    if (track) {
      track.addEventListener(
        "touchstart",
        function (e) {
          mTx = e.changedTouches[0].clientX;
        },
        { passive: true },
      );
      track.addEventListener(
        "touchend",
        function (e) {
          var dx = e.changedTouches[0].clientX - mTx;
          if (Math.abs(dx) > 40)
            dx > 0 ? mSlide(selectedIdx - 1) : mSlide(selectedIdx + 1);
        },
        { passive: true },
      );
    }

    selectPhoto(0, { scrollToMain: false });
  })();
</script>

