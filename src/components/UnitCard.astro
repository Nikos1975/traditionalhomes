---
import { Image } from "astro:assets";
import siteCopy from "../data/siteCopy.json";
import { defaultLocale, type Locale } from "../i18n/config";
import { housePath, villaPath } from "../i18n/routes";
import { resolveLocalizedLink } from '../i18n/route-map';
import { getCommonCopy } from "../i18n/translate";
import { formatPropertyCount } from "../i18n/property-counts";
import type { InventoryUnit } from "../types";

interface Props {
  unit: InventoryUnit;
  priority?: boolean;
  locale?: Locale;
}

const { unit, priority = false, locale = defaultLocale } = Astro.props;
const propertyCopy = getCommonCopy(locale).ui.property;

// 1. PATH LOGIC (Matches your localized folder structure)
const unitPageLink =
  unit.type === "villa"
    ? resolveLocalizedLink(locale, 'villa', unit.slug)
    : resolveLocalizedLink(locale, 'house', unit.slug);

// 2. IMAGE AUTOMATION
const allImages = import.meta.glob(
  "/src/assets/images/**/*.{webp,jpg,jpeg,png}",
  { eager: true },
);
const propertyFolder =
  unit.type === "villa"
    ? `/src/assets/images/villa/`
    : `/src/assets/images/houses/${unit.slug}/`;

// Find the hero image or fallback to the first one in the folder
const propertyImages = Object.keys(allImages).filter((key) =>
  key.includes(propertyFolder),
);
const featuredImgAsset = (
  allImages[
    propertyImages.find((key) => key.toLowerCase().includes("hero")) ||
      propertyImages[0]
  ] as any
)?.default;

// 3. UI HELPERS
const displayLocation =
  unit.village === "Mavrikiano" && unit.area === "Elounda"
    ? "Mavrikiano, Elounda"
    : unit.location;
const homepageFeatureKeys: Record<string, keyof typeof propertyCopy.card.features> = {
  argyro: "directSeaView",
  leonidas: "directSeaView",
  margarita: "directSeaView",
  monastiri: "directSeaViewPrivatePool",
  demetra: "sharedPool",
  penelope: "sharedPool",
  erato: "privatePool",
  clio: "firstFloor",
  efterpi: "groundFloor",
  kalliopi: "firstFloor",
  "almond-tree-villa": "privateVillaVrouchas",
};
const homepageFeatureKey = homepageFeatureKeys[unit.slug];
const homepageFeatureLabel = homepageFeatureKey ? propertyCopy.card.features[homepageFeatureKey] : undefined;
---

<article
  class="group bg-white rounded-[2rem] overflow-hidden border border-stone-100 shadow-premium hover:shadow-premium-hover hover:-translate-y-1 transition-all duration-500 flex flex-col"
  data-id={unit.slug}
>
  {/* OPTIMIZED IMAGE SECTION */}
  <a
    href={unitPageLink.href} hreflang={unitPageLink.hreflang}
    class="block relative overflow-hidden bg-stone-900 aspect-[4/3]"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      featuredImgAsset ? (
        <Image
          src={featuredImgAsset}
          alt={unit.name}
          widths={[320, 480, 672, 768]}
          quality={68}
          sizes="
            (min-width: 1344px) 373px,
            (min-width: 1024px) calc((100vw - 160px) / 3),
            (min-width: 640px) calc((100vw - 88px) / 2),
            calc(100vw - 32px)
          "
          loading={priority ? "eager" : "lazy"}
          class="w-full h-full object-cover opacity-90 transition-transform duration-[10s] ease-out group-hover:scale-105"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-stone-400 text-[10px] uppercase tracking-[0.2em] font-bold">
          {propertyCopy.card.photoComingSoon}
        </div>
      )
    }
  </a>

  <div class="flex flex-col flex-1 p-8">
    {/* HEADER */}
    <div class="flex items-start justify-between gap-4 mb-6">
      <div>
        <p
          class="text-[9px] uppercase tracking-[0.3em] text-stone-400 mb-2 font-bold"
        >
          {displayLocation}
        </p>
        <a
          href={unitPageLink.href} hreflang={unitPageLink.hreflang}
          class="font-serif text-3xl text-body-text group-hover:text-primary transition-colors leading-tight block"
        >
          {unit.name}
        </a>
      </div>
      {
        unit.type === "villa" && (
          <span class="px-3 py-1 bg-stone-100 text-stone-600 border border-stone-200 text-[9px] uppercase font-bold tracking-[0.2em] rounded-full">
            {propertyCopy.card.villa}
          </span>
        )
      }
    </div>

    {/* SPECS GRID */}
    <div class="grid grid-cols-2 gap-y-4 mb-8">
      <span class="flex items-center gap-3 text-xs text-stone-500 font-light">
        <svg
          class="text-stone-400"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle
            cx="12"
            cy="7"
            r="4"></circle></svg
        >
        {formatPropertyCount(locale, unit.sleeps, propertyCopy.counts.guestsUpTo)}
      </span>
      <span class="flex items-center gap-3 text-xs text-stone-500 font-light">
        <svg
          class="text-stone-400"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          ><path d="M2 4v16"></path><path d="M2 8h18a2 2 0 0 1 2 2v10"
          ></path><path d="M2 17h20"></path><path d="M6 8v9"></path></svg
        >
        {formatPropertyCount(locale, unit.bedrooms, propertyCopy.counts.bedrooms)}
      </span>
      {homepageFeatureLabel && (
        <span class="col-span-2 flex items-center gap-3 text-xs font-medium text-stone-600">
          <svg
            class="text-stone-400"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M4 12h16"></path>
            <path d="M4 18h16"></path>
            <path d="M4 6h16"></path>
          </svg>
          {homepageFeatureLabel}
        </span>
      )}
    </div>

    {/* ACCESS ALERT (Editorial Note Style) */}
    {
      unit.accessDetail && (
        <div class="mb-8 p-4 bg-amber-50/50 border border-amber-100 rounded-2xl">
          <p class="text-[11px] text-amber-900/80 leading-relaxed italic">
            <strong>{propertyCopy.card.editorNote}</strong> {unit.accessDetail}
          </p>
        </div>
      )
    }

    {/* ACTION BUTTONS */}
    <div class="mt-auto pt-6 border-t border-stone-100 flex gap-3">
      <a
        href={unitPageLink.href} hreflang={unitPageLink.hreflang}
        class="btn-outline flex-1 py-3 px-0 text-center rounded-xl bg-white shadow-sm hover:shadow-md transition-shadow"
      >
        {propertyCopy.card.details}
      </a>
      <a
        href={siteCopy.bookingEngineUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-cta booking-cta flex-1 py-3 px-0 text-center rounded-xl shadow-sm hover:shadow-md transition-shadow"
      >
        {propertyCopy.card.checkDates}
      </a>
    </div>
  </div>
</article>
