---
import { defaultLocale, type Locale } from '../i18n/config';
import { resolveAuthoredHref } from '../i18n/route-map';
import { getCommonCopy } from '../i18n/translate';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const common = getCommonCopy(locale);

// Authored hrefs are resolved through the route map, so a locale that owns a
// translated route gets its own public URL. Sections with no page in the active
// locale keep the default-locale URL and are tagged with hreflang, which keeps
// the fallback explicit instead of silent.
const withHreflang = <T extends { href: string; label: string }>(links: readonly T[]) =>
  links.map((link) => {
    const resolved = resolveAuthoredHref(locale, link.href);

    return { label: link.label, href: resolved.href, hreflang: resolved.hreflang };
  });

const collectionLinks = withHreflang(common.footer.collection.links);
const informationLinks = withHreflang(common.footer.information.links);
const legalLinks = withHreflang(common.footer.legal.links);

const currentYear = new Date().getFullYear();
const bookingUrl = 'https://traditionalhomes.reserve-online.net/';
---

<footer class="bg-stone-950 text-stone-400 relative overflow-hidden">
  <div class="site-max site-pad py-16 lg:py-24 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8">

      {/* BRAND COLUMN (Takes up more space) */}
      <div class="md:col-span-5 lg:col-span-4 pr-4">
        <div class="mb-6 flex flex-col items-start gap-4">
          <img 
            src="/images/brand/eh-mark-144.webp"
            alt={common.brand.markAlt}
            width="48"
            height="48"
            class="h-12 w-12 opacity-60"
          />
          <div>
            <p class="font-serif text-3xl text-stone-50 leading-tight tracking-wide">{common.brand.name}</p>
            <p class="text-[10px] uppercase tracking-[0.3em] font-bold text-stone-500 mt-2">{common.brand.kicker}</p>
          </div>
        </div>
        <p class="text-sm text-stone-400 leading-relaxed font-light max-w-sm">
          {common.footer.description}
        </p>
      </div>

      {/* SPACER FOR GRID ALIGNMENT */}
      <div class="hidden lg:block lg:col-span-2"></div>

      {/* PROPERTIES COLUMN */}
      <div class="md:col-span-3 lg:col-span-3">
        <h3 class="font-sans font-bold text-stone-50 text-[10px] uppercase tracking-[0.2em] mb-6">{common.footer.collection.heading}</h3>
        <ul class="space-y-4 text-sm font-light">
          {collectionLinks.map((link) => (
            <li><a href={link.href} hreflang={link.hreflang} class="hover:text-stone-50 transition-colors duration-300">{link.label}</a></li>
          ))}
          <li class="pt-2">
            <a
              href={bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] font-bold text-accent-sage hover:text-primary transition-colors duration-300"
            >
              {common.footer.collection.availabilityLabel}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </li>
        </ul>
      </div>

      {/* INFORMATION COLUMN */}
      <div class="md:col-span-4 lg:col-span-3">
        <h3 class="font-sans font-bold text-stone-50 text-[10px] uppercase tracking-[0.2em] mb-6">{common.footer.information.heading}</h3>
        <ul class="space-y-4 text-sm font-light">
          {informationLinks.map((link) => (
            <li><a href={link.href} hreflang={link.hreflang} class="hover:text-stone-50 transition-colors duration-300">{link.label}</a></li>
          ))}
        </ul>
      </div>

    </div>

    {/* BOTTOM BAR */}
    <div class="border-t border-stone-800 mt-16 pt-8 flex flex-col gap-5 md:flex-row md:items-center md:justify-between md:gap-8">
      <p class="text-[11px] text-stone-400/80 font-light tracking-wide">
        &copy; {currentYear} {common.brand.name}. {common.footer.rights}
      </p>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-3 text-[11px] font-light tracking-wide md:justify-end" aria-label={common.footer.legal.ariaLabel}>
        {legalLinks.map((link) => (
          <a href={link.href} hreflang={link.hreflang} class:list={[
            'transition-colors duration-300',
            link.href.startsWith('https://') ? 'whitespace-nowrap text-stone-400 hover:text-stone-200' : 'text-stone-400/85 hover:text-stone-200'
          ]}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
