---
import inventory from '../inventory/inventory.json';
import { housePath } from '../i18n/routes';
import { defaultLocale, type Locale } from '../i18n/config';
import { unitList, unitName, unitText } from '../i18n/inventory-display';
import { getCommonCopy } from '../i18n/translate';
import { formatPropertyCount } from '../i18n/property-counts';
import type { InventoryUnit } from '../types';

interface Props {
  unit: InventoryUnit;
  locale?: Locale;
}

const { unit, locale = defaultLocale } = Astro.props;
const propertyCopy = getCommonCopy(locale).ui.property;
const derivedCopy = propertyCopy.derived;
const sharedPoolCopy = propertyCopy.detail.sharedPool;

/**
 * Properties that share this pool, resolved through the authoritative inventory.
 *
 * `sharedPoolWith` holds stable routing keys, not names: the inventory owns the
 * unit's identity and name, and `unitName` presents that name in the active
 * locale. A key the inventory does not own is not rendered at all, so a slug can
 * never reach the page as if it were a property name.
 */
const sharedPoolUnits = (unit.sharedPoolWith ?? [])
  .map((sharedSlug) => (inventory as InventoryUnit[]).find((candidate) => candidate.slug === sharedSlug))
  .filter((shared): shared is InventoryUnit => Boolean(shared));

// Determine if there's a custom bathroom constraint (e.g. courtyard access).
// The constraint itself is a factual inventory value, so it is read back through
// the locale's presentation of that same list rather than re-authored here.
const localizedConstraints = unitList(locale, unit.slug, 'hardConstraints', unit.hardConstraints);
const bathroomConstraintIndex = unit.hardConstraints.findIndex(c => c.toLowerCase().includes('bathroom'));
const bathroomConstraint = bathroomConstraintIndex >= 0 ? unit.hardConstraints[bathroomConstraintIndex] : undefined;
let bathroomLabel = '';
if (bathroomConstraint) {
  bathroomLabel = bathroomConstraint.toLowerCase().includes('courtyard')
    ? derivedCopy.bathroom.viaCourtyard
    : localizedConstraints[bathroomConstraintIndex] ?? bathroomConstraint;
}

// Casing normalizations
const formatView = (str: string) => {
  if (!str) return '';
  let s = str.charAt(0).toUpperCase() + str.slice(1);
  return s.replace('1st-floor', 'first-floor').replace('1st floor', 'first floor');
};

const formatParking = (str: string) => {
  if (!str) return '';
  return str.charAt(0).toUpperCase() + str.slice(1);
};

const formatBathroom = (unit: InventoryUnit) => {
  if (unit.slug === 'clio') return derivedCopy.bathroom.showerRoom;
  // These two spell the count out in full rather than using the compact label.
  if (unit.slug === 'erato' || unit.slug === 'almond-tree-villa') {
    return formatPropertyCount(locale, unit.bathrooms, propertyCopy.counts.bathrooms);
  }
  return formatPropertyCount(locale, unit.bathrooms, propertyCopy.counts.bathroomsCompact);
};

const formatLayout = (unit: InventoryUnit) => {
  const layout = derivedCopy.layout;

  if (unit.slug === 'almond-tree-villa') return layout.splitLevelVilla;
  if (unit.slug === 'clio' || unit.slug === 'erato') return layout.connectedLevelsOntas;
  if (unit.slug === 'penelope') return layout.mainLevelOntas;
  if (unit.slug === 'leonidas') return layout.mainLivingSpaceOntas;
  if (unit.slug === 'efterpi') return layout.courtyardLevelOntas;
  if (unit.slug === 'kalliopi') return layout.firstFloorAboveEfterpiOntas;
  if (unit.slug === 'monastiri') return layout.multiLevelInternalStairs;
  return unit.floors === 1 ? layout.groundFloor : layout.groundAndFirstFloor;
};

const formatAccess = (unit: InventoryUnit) => {
  const access = derivedCopy.access;

  if (unit.slug === 'almond-tree-villa') return access.internalStairsSteppedLevels;
  if (unit.slug === 'clio') return access.entranceStepInternalStairs;
  if (unit.slug === 'leonidas') return access.stoneStepsInternalWoodenStairs;
  if (unit.slug === 'penelope') return access.externalStepsInternalStairsToOntas;
  if (unit.slug === 'margarita') return access.courtyardEntryInternalStairs;
  if (unit.slug === 'efterpi') return access.stepsDownToCourtyardStairToOntas;
  if (unit.slug === 'kalliopi') return access.stoneStairsBalconyEntrance;
  if (unit.slug === 'monastiri') return access.courtyardEntranceInternalStairs;
  if (!unit.internalStairs) return access.stepFree;
  const hasStairsDownEntrance = unit.hardConstraints.some((constraint) =>
    constraint.toLowerCase().includes('stairs down')
  );

  return hasStairsDownEntrance ? access.internalStairsEntranceViaStairsDown : access.internalStairs;
};
---

<section class="mb-12">
  
  {/* The 2-Column Grid */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    
    {/* Group 1: Property Basics */}
    <div class="bg-stone-200/30 rounded-[2rem] p-6 md:p-7 border border-stone-200/80 flex flex-col gap-4 transition-all hover:bg-stone-200/50">
      <h3 class="text-[10px] uppercase tracking-[0.15em] text-stone-400 font-medium mb-1">
        {unit.type === 'villa' ? propertyCopy.basics.villa : propertyCopy.basics.house}
      </h3>
      
      {/* Sleeps */}
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <div>
          <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">{propertyCopy.labels.sleeps}</span>
          <span class="block text-xl font-serif text-body-text leading-none">{unit.sleeps}</span>
        </div>
      </div>

      {/* Size */}
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line></svg>
        </div>
        <div>
          <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">{propertyCopy.labels.size}</span>
          <span class="block text-xl font-serif text-body-text leading-none">{unit.areaSqm} m²</span>
        </div>
      </div>

      {/* Bedrooms */}
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"></path><path d="M2 8h18a2 2 0 0 1 2 2v10"></path><path d="M2 17h20"></path><path d="M6 8v9"></path></svg>
        </div>
        <div>
          <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">{propertyCopy.labels.bedrooms}</span>
          <span class="block text-xl font-serif text-body-text leading-none">{unit.bedrooms}</span>
        </div>
      </div>

      {/* Bath */}
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-2.12 0l-.88.88a1.5 1.5 0 0 0 0 2.12L6 9M2 13h20M2 13c0 5.5 4.5 10 10 10s10-4.5 10-10M2 13c0-3.5 3-6 10-6"/></svg>
        </div>
        <div>
          <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">
            {unit.bathrooms === 1 ? propertyCopy.labels.bathroom : propertyCopy.labels.bathrooms}
          </span>
          <span class="block text-xl font-serif text-body-text leading-none">{formatBathroom(unit)}</span>
        </div>
      </div>

      {/* Layout */}
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
        </div>
        <div>
          <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">{propertyCopy.labels.layout}</span>
          <span class="block text-xl font-serif text-body-text leading-none">
            {formatLayout(unit)}
          </span>
        </div>
      </div>
    </div>

    {/* Group 2: Practical Use */}
    <div class="bg-stone-200/30 rounded-[2rem] p-6 md:p-7 border border-stone-200/80 flex flex-col gap-4 transition-all hover:bg-stone-200/50">
      <h3 class="text-[10px] uppercase tracking-[0.15em] text-stone-400 font-medium mb-1">{propertyCopy.labels.practicalUse}</h3>

      {/* View */}
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </div>
        <div>
          <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">{propertyCopy.labels.view}</span>
          <span class="block text-xl font-serif text-body-text leading-tight">{formatView(unitText(locale, unit.slug, 'view', unit.view) ?? unit.view)}</span>
        </div>
      </div>

      {/* Access */}
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
        </div>
        <div>
          <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">{propertyCopy.labels.access}</span>
          <span class="block text-xl font-serif text-body-text leading-tight">
            {formatAccess(unit)}
          </span>
        </div>
      </div>

      {/* Bathroom (conditional, e.g. courtyard access) */}
      {bathroomLabel && (
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </div>
          <div>
            <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">{propertyCopy.labels.bathroom}</span>
            <span class="block text-xl font-serif text-body-text leading-tight">{bathroomLabel}</span>
          </div>
        </div>
      )}

      {/* Parking */}
      <div class="flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-primary/70 shadow-sm shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
        </div>
        <div>
          <span class="block text-[10px] text-muted uppercase tracking-[0.05em] font-medium mb-0.5">{propertyCopy.labels.parking}</span>
          <span class="block text-xl font-serif text-body-text leading-tight">{formatParking(unitText(locale, unit.slug, 'parking', unit.parking) ?? unit.parking)}</span>
        </div>
      </div>
    </div>

  </div>

  {/* Shared Pool Upsell Notice */}
  {unit.pool === 'shared' && unit.sharedPoolWith && (
    <div class="mt-8 p-6 bg-stone-100/50 border border-stone-200/60 rounded-[1.5rem] flex items-start gap-4 shadow-sm">
      <div class="w-8 h-8 rounded-full bg-white border border-stone-200 flex items-center justify-center flex-shrink-0 text-primary">
         <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      </div>
      <p class="text-sm text-stone-600 leading-relaxed font-light pt-1">
        {sharedPoolCopy.intro}
        {sharedPoolUnits.map((shared, index) => (
          <span>
            {index > 0 ? ` ${sharedPoolCopy.and} ` : ' '}
            <a href={housePath(shared.slug, locale)} class="font-medium text-body-text underline hover:text-primary transition-colors">
              {unitName(locale, shared.slug, shared.name)}
            </a>
          </span>
        ))}. {sharedPoolCopy.note}
      </p>
    </div>
  )}
</section>
