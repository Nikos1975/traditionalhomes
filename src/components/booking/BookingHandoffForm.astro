---
import { defaultLocale } from '../../i18n/config';
import { getFormsCopy } from '../../i18n/translate';

interface Props {
  bookingBaseUrl: string;
  roomCode?: string | null;
  itemName?: string;
  maxAdults?: number;
  title?: string;
  description?: string;
  submitLabel?: string;
  compact?: boolean;
  framed?: boolean;
  trackView?: boolean;
  locale?: string;
}

const props = Astro.props;
const locale = props.locale ?? defaultLocale;
const bookingCopy = getFormsCopy(locale).booking;

const {
  bookingBaseUrl,
  roomCode = null,
  itemName = bookingCopy.defaultItemName,
  maxAdults = 10,
  title = bookingCopy.defaultTitle,
  description = bookingCopy.defaultDescription,
  submitLabel = bookingCopy.checkAvailability,
  compact = false,
  framed = true,
  trackView = false,
} = props;

const adultsDefault = Math.min(2, Math.max(1, maxAdults));
---

<form
  class:list={[
    'booking-handoff-form mx-auto w-full',
    framed && 'rounded-2xl border border-stone-200 bg-white shadow-sm',
    framed && (compact ? 'py-4 px-5 md:py-5 md:px-6 max-w-3xl' : 'p-5 md:p-6 max-w-md'),
  ]}
  action={bookingBaseUrl}
  method="get"
  target="_blank"
  rel="noopener noreferrer"
  data-booking-handoff
  data-item-name={itemName}
  data-room-code={roomCode ?? ''}
  data-track-view={trackView ? 'true' : 'false'}
>
  <div class={compact ? 'mb-3' : 'mb-4'}>
    <p class="font-serif text-lg text-body-text leading-tight">{title}</p>
    <p class="mt-0.5 text-xs text-muted leading-relaxed">{description}</p>
  </div>

  <div class:list={[
    'grid gap-3',
    compact ? 'grid-cols-1 sm:grid-cols-3' : 'grid-cols-1',
  ]}>
    <label class="block">
      <span class="block text-[10px] uppercase tracking-[0.2em] font-bold text-stone-500 mb-1">
        {bookingCopy.arrival}
      </span>
      <input
        type="date"
        name="checkin"
        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 outline-none transition-colors focus:border-accent-sage focus:bg-white"
        data-booking-checkin
      />
    </label>

    <label class="block">
      <span class="block text-[10px] uppercase tracking-[0.2em] font-bold text-stone-500 mb-1">
        {bookingCopy.nights}
      </span>
      <input
        type="number"
        name="nights"
        min="1"
        max="60"
        value="7"
        inputmode="numeric"
        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 outline-none transition-colors focus:border-accent-sage focus:bg-white"
      />
    </label>

    <label class="block">
      <span class="block text-[10px] uppercase tracking-[0.2em] font-bold text-stone-500 mb-1">
        {bookingCopy.adults}
      </span>
      <input
        type="number"
        name="adults"
        min="1"
        max={maxAdults}
        value={adultsDefault}
        inputmode="numeric"
        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-sm text-stone-900 outline-none transition-colors focus:border-accent-sage focus:bg-white"
      />
    </label>
  </div>

  {roomCode && <input type="hidden" name="room" value={roomCode} data-booking-room />}

  <button
    type="submit"
    class:list={[
      'btn-cta booking-cta w-full justify-center text-center rounded-xl shadow-md transition-all',
      compact ? 'mt-3 py-2.5' : 'mt-4 py-3',
    ]}
  >
    {submitLabel}
  </button>

  {roomCode && (
    <button
      type="submit"
      class="mt-2 w-full rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-center font-sans text-[10px] font-bold uppercase tracking-[0.2em] text-stone-700 transition-colors hover:border-accent-sage hover:text-stone-950"
      data-search-all-houses
    >
      {bookingCopy.searchAllAvailableProperties}
    </button>
  )}

  <p class="mt-2.5 text-[10px] text-muted leading-relaxed">
    {bookingCopy.finalAvailabilityNote}
  </p>
</form>

<script>
  function initBookingHandoffForms() {
    const analyticsWindow = window as Window & {
      dataLayer?: Array<Record<string, unknown>>;
    };
    const forms = document.querySelectorAll<HTMLFormElement>('[data-booking-handoff]');
    const today = new Date();
    const todayValue = new Date(today.getTime() - today.getTimezoneOffset() * 60000)
      .toISOString()
      .slice(0, 10);

    forms.forEach((form) => {
      if (form.dataset.bookingInitialized === 'true') return;
      form.dataset.bookingInitialized = 'true';

      const checkin = form.querySelector<HTMLInputElement>('[data-booking-checkin]');
      if (checkin) {
        checkin.min = todayValue;
      }

      const itemName = form.dataset.itemName || 'Elounda Traditional Homes';
      const roomCode = form.dataset.roomCode || undefined;

      if (form.dataset.trackView === 'true') {
        analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
        analyticsWindow.dataLayer.push({
          event: 'view_item',
          ecommerce: {
            items: [
              {
                item_id: roomCode,
                item_name: itemName,
                item_category: 'Accommodation',
              },
            ],
          },
        });
      }

      form.addEventListener('submit', (event) => {
        const submitter = (event as SubmitEvent).submitter as HTMLElement | null;
        const searchAll = Boolean(submitter?.hasAttribute('data-search-all-houses'));
        const roomInput = form.querySelector<HTMLInputElement>('[data-booking-room]');

        if (searchAll && roomInput) {
          roomInput.disabled = true;
          window.setTimeout(() => {
            roomInput.disabled = false;
          }, 0);
        }

        analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
        analyticsWindow.dataLayer.push({
          event: 'select_item',
          ecommerce: {
            items: [
              {
                item_id: searchAll ? undefined : roomCode,
                item_name: searchAll ? 'Elounda Traditional Homes Collection' : itemName,
                item_category: 'Accommodation',
              },
            ],
          },
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initBookingHandoffForms);
  initBookingHandoffForms();
</script>
