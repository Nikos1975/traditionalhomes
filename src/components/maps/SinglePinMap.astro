---
import LeafletMap from './LeafletMap.astro';
import type { LocationItem } from '../../data/locations';
import { defaultLocale, type Locale } from '../../i18n/config';
import { housePath, villaPath } from '../../i18n/routes';
import { resolveLocalizedLink } from '../../i18n/route-map';
import { getCommonCopy } from '../../i18n/translate';

interface Props {
  location: LocationItem;
  height?: string;
  /** Active locale, passed explicitly by the page renderer. */
  locale?: Locale;
}

const { location, height = '300px', locale = defaultLocale } = Astro.props;
const mapCopy = getCommonCopy(locale).ui.map;

interface MarkerData {
  id: string;
  lat: number;
  lng: number;
  title: string;
  url: string;
  subtitle: string;
}

let markers: MarkerData[] = [];
if (location && location.lat && location.lng) {
  const propertyUrl = location.type === 'villa'
    ? villaPath(location.slug, locale)
    : housePath(location.slug, locale);

  markers.push({
    id: location.id,
    lat: location.lat,
    lng: location.lng,
    title: location.title,
    url: propertyUrl,
    subtitle: location.locationLabel
  });
}

const locationLink = resolveLocalizedLink(locale, 'location');
const locationMapPath = `${locationLink.href}?id=${location.id}#map-section`;
---
{markers.length > 0 ? (
  <div class="single-pin-map relative border border-stone-200 rounded-xl overflow-hidden shadow-sm">
    <LeafletMap markers={markers} zoom={16} height={height} mapId={`map-${location.id}`} locale={locale} />
    <div class="bg-stone-50 border-t border-stone-200 px-4 py-3 flex justify-between items-center">
      <div class="text-xs text-stone-600">
        <span class="font-medium text-stone-800">{location.title}</span><br/>
        {location.locationLabel}
      </div>
      <a href={locationMapPath} class="text-xs px-3 py-1.5 bg-white border border-stone-300 rounded hover:bg-stone-100 font-medium text-stone-700 transition-colors">
        {mapCopy.actions.viewMap}
      </a>
    </div>
  </div>
) : (
  <div class="bg-stone-50 rounded-xl p-8 text-center text-stone-500 text-sm border border-stone-200" style={`height: ${height}; display: flex; align-items: center; justify-content: center;`}>
    {mapCopy.unavailable}
  </div>
)}
