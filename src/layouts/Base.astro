---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/images/og-default.jpg',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://traditional-homes.gr';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const robotsContent = noindex
  ? 'noindex'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="robots" content={robotsContent} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:image:alt" content={title} />
    <meta name="theme-color" content="#B44B2A" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="Elounda Traditional Homes" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Font Preloads -->
    <link rel="preload" href="/fonts/work-sans/regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond/regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond/500.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Page-specific head content (preloads, meta, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <form
      id="mobile-booking-bar"
      class="mobile-booking-bar"
      action="https://traditionalhomes.reserve-online.net/"
      method="get"
      target="_blank"
      data-mobile-booking-bar
      aria-label="Quick availability search"
    >
      <label>
        <span>Arrival</span>
        <input type="date" name="checkin" data-mobile-checkin />
      </label>
      <label>
        <span>Nights</span>
        <input type="number" name="nights" min="1" max="60" value="7" inputmode="numeric" />
      </label>
      <label>
        <span>Adults</span>
        <input type="number" name="adults" min="1" max="10" value="2" inputmode="numeric" data-mobile-adults />
      </label>
      <input type="hidden" name="room" value="" data-mobile-room />
      <button type="submit">Check</button>
    </form>

    <button
      id="chat-trigger"
      aria-label="Open chat"
      title="Questions? Chat with us"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </button>

    <script>
      document.addEventListener('astro:page-load', () => {
        document.getElementById('chat-trigger')?.addEventListener('click', () => {
          const loaded = document.getElementById('chat-widget');
          if (!loaded) {
            const div = document.createElement('div');
            div.id = 'chat-widget';
            div.innerHTML = '<p style="position:fixed;bottom:5rem;right:1.5rem;background:#E7F0ED;color:#2C2419;padding:1rem 1.25rem;border:1px solid #98BCB4;border-radius:0.5rem;font-size:0.875rem;max-width:260px;z-index:50;box-shadow:0 8px 32px rgba(44,36,25,0.16)">For booking enquiries, please use the availability button or email <a href="mailto:info@traditional-homes.gr" style="color:#2C2419;text-decoration:underline;font-weight:600">info@traditional-homes.gr</a>. Chat coming soon.</p>';
            document.body.appendChild(div);
            setTimeout(() => div.remove(), 5000);
          }
        });

        const reveals = document.querySelectorAll('.reveal');
        if (reveals.length && 'IntersectionObserver' in window) {
          const obs = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add('visible');
                  obs.unobserve(e.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
          );
          reveals.forEach((el) => obs.observe(el));
        }
      });

      const mobileBookingBar = document.querySelector<HTMLFormElement>('[data-mobile-booking-bar]');
      const pageBookingForm = document.querySelector<HTMLFormElement>('[data-booking-handoff]');

      if (mobileBookingBar && mobileBookingBar.dataset.initialized !== 'true') {
        mobileBookingBar.dataset.initialized = 'true';

        const today = new Date();
        const todayValue = new Date(today.getTime() - today.getTimezoneOffset() * 60000)
          .toISOString()
          .slice(0, 10);
        const checkin = mobileBookingBar.querySelector<HTMLInputElement>('[data-mobile-checkin]');
        const adults = mobileBookingBar.querySelector<HTMLInputElement>('[data-mobile-adults]');
        const room = mobileBookingBar.querySelector<HTMLInputElement>('[data-mobile-room]');

        if (checkin) checkin.min = todayValue;

        if (pageBookingForm) {
          mobileBookingBar.action = pageBookingForm.action;

          const roomCode = pageBookingForm.dataset.roomCode || '';
          const maxAdults = pageBookingForm.querySelector<HTMLInputElement>('input[name="adults"]')?.max;

          if (room) {
            room.value = roomCode;
            room.disabled = !roomCode;
          }

          if (adults && maxAdults) {
            adults.max = maxAdults;
          }
        } else if (room) {
          room.disabled = true;
        }

        mobileBookingBar.addEventListener('submit', () => {
          const analyticsWindow = window as Window & {
            dataLayer?: Array<Record<string, unknown>>;
          };
          const itemName = pageBookingForm?.dataset.itemName || 'Elounda Traditional Homes';
          const roomCode = pageBookingForm?.dataset.roomCode || undefined;

          analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
          analyticsWindow.dataLayer.push({
            event: 'select_item',
            ecommerce: {
              items: [
                {
                  item_id: roomCode,
                  item_name: itemName,
                  item_category: 'Accommodation',
                },
              ],
            },
          });
        });
      }
    </script>
  </body>
</html>
