---
import HouseDetailPage from '../../../components/pages/HouseDetailPage.astro';
import inventory from '../../../inventory/inventory.json';
import { validateInventory } from '../../../utils/validateInventory';
import { publicSlug } from '../../../i18n/route-map';
import type { InventoryUnit } from '../../../types';

/**
 * Only houses the route map declares for German are generated. Adding a house
 * here is a route-map + content change, not a component change.
 */
export async function getStaticPaths() {
  const units = inventory as InventoryUnit[];
  validateInventory(units);

  return units
    .filter((unit) => unit.type === 'house')
    .flatMap((unit) => {
      const slug = publicSlug('de', 'house', unit.slug);
      return slug ? [{ params: { slug }, props: { unit } }] : [];
    });
}

const { unit } = Astro.props as { unit: InventoryUnit };
---

<HouseDetailPage locale="de" unit={unit} />
