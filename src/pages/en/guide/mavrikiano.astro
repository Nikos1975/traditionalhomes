---
import GuidePage from '../../../components/pages/GuidePage.astro';
import * as Guide from '../../../guides/Mavrikiano-Guide.md';
import { guideFrontmatter } from '../../../guides/frontmatter';
import { defaultLocale } from '../../../i18n/config';

const { Content, frontmatter } = Guide;
const guide = guideFrontmatter(frontmatter, 'src/guides/Mavrikiano-Guide.md');
---

<GuidePage
  locale={defaultLocale}
  guideId="mavrikiano"
  frontmatter={guide}
  fallbackDescription="Practical information for your stay in Mavrikiano."
>
  <Content />
</GuidePage>
