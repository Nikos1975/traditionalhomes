---
import Base from '../../layouts/Base.astro';
import siteCopyData from '../../data/siteCopy.json';
import MasterLocationMap from '../../components/maps/MasterLocationMap.astro';
import inventory from '../../inventory/inventory.json';
import { locations } from '../../data/locations';
import { defaultLocale } from '../../i18n/config';
import { guidePath, housePath, localizedPath, villaPath } from '../../i18n/routes';
import { getPageSeo, localizedCanonical } from '../../i18n/seo';
import type { InventoryUnit, SiteCopy } from '../../types';

const units = inventory as InventoryUnit[];
const siteCopy = siteCopyData as SiteCopy;
const pageSeo = getPageSeo(defaultLocale, 'location');

// Map Data Integration
const mapMarkers = locations.map(loc => {
  const unit = units.find(u => u.slug === loc.slug);
  return {
    ...loc,
    name: unit?.name || loc.title,
    type: unit?.type || 'house'
  };
});

const badgeStyles = {
  sand: 'bg-[#f4eddf] border-[#e8dccb] text-stone-600',
  terracotta: 'bg-[#f3e2d9] border-[#e7c9bc] text-[#8a4a35]',
  sage: 'bg-accent-sage-soft border-accent-sage/50 text-stone-700',
  stone: 'bg-white border-stone-200 text-stone-500',
  blueGrey: 'bg-[#e8edf0] border-[#d7e0e4] text-slate-600',
};

type BadgeTone = keyof typeof badgeStyles;

const collectionGroups = [
  {
    label: 'Sea-view standalone houses',
    slugs: ['argyro', 'leonidas', 'margarita', 'monastiri'],
  },
  {
    label: 'Paired houses',
    slugs: ['efterpi', 'kalliopi'],
  },
  {
    label: 'Shared-pool houses',
    slugs: ['demetra', 'penelope'],
  },
  {
    label: 'Private-pool / upper house pair',
    slugs: ['erato', 'clio'],
  },
  {
    label: 'Vrouchas villa',
    slugs: ['almond-tree-villa'],
  },
];

const collectionMetadata: Record<string, { label: string; tone: BadgeTone }[]> = {
  argyro: [
    { label: 'Sea view', tone: 'sand' },
    { label: 'Standalone', tone: 'stone' },
  ],
  leonidas: [
    { label: 'Sea view', tone: 'sand' },
    { label: 'Standalone', tone: 'stone' },
  ],
  margarita: [
    { label: 'Sea view', tone: 'sand' },
    { label: 'Standalone', tone: 'stone' },
  ],
  monastiri: [
    { label: 'Sea view', tone: 'sand' },
    { label: 'Private pool', tone: 'terracotta' },
  ],
  efterpi: [
    { label: 'Ground floor', tone: 'stone' },
  ],
  kalliopi: [
    { label: 'First floor', tone: 'stone' },
  ],
  demetra: [
    { label: 'Ground floor', tone: 'stone' },
    { label: 'Shared pool', tone: 'sage' },
  ],
  penelope: [
    { label: 'First floor', tone: 'stone' },
    { label: 'Shared pool', tone: 'sage' },
  ],
  erato: [
    { label: 'Ground floor', tone: 'stone' },
    { label: 'Private pool', tone: 'terracotta' },
  ],
  clio: [
    { label: 'First floor', tone: 'stone' },
    { label: 'No pool', tone: 'stone' },
  ],
  'almond-tree-villa': [
    { label: 'Vrouchas', tone: 'blueGrey' },
    { label: 'Private villa', tone: 'blueGrey' },
  ],
};

const unitBySlug = new Map(units.map((unit) => [unit.slug, unit]));

---

<Base
  title={pageSeo.title}
  description={pageSeo.description}
  canonicalUrl={localizedCanonical(defaultLocale, localizedPath(defaultLocale, 'location'))}
>

  <div class="site-max site-pad py-16 md:py-24">

    {/* BREADCRUMB */}
    <nav class="text-[10px] uppercase tracking-[0.4em] text-stone-400 mb-12 font-bold" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2" role="list">
        <li><a href={localizedPath(defaultLocale)} class="hover:text-stone-900 transition-colors">Home</a></li>
        <li aria-hidden="true" class="text-stone-200">/</li>
        <li class="text-stone-900" aria-current="page">Location</li>
      </ol>
    </nav>

    <header class="max-w-4xl mb-20">
      <h1 class="font-serif text-5xl md:text-8xl text-stone-950 mb-8 leading-tight tracking-tight">
        The <span class="italic text-stone-400">Setting</span>
      </h1>
      <p class="text-2xl text-stone-500 font-light leading-relaxed font-serif italic max-w-2xl">
        Mavrikiano and Vrouchas sit on the hillside above Elounda, with village paths, sea views, parking details, and beaches close by car.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 mb-32">
      
      {/* MAIN CONTENT */}
      <div class="lg:col-span-7 space-y-20">

        <section id="mavrikiano" aria-labelledby="mavrikiano-heading">
          <div class="flex items-center gap-4 mb-6">
             <span class="text-[10px] font-bold text-primary tracking-widest uppercase">Village 01</span>
             <h2 id="mavrikiano-heading" class="font-serif text-4xl text-stone-950">Mavrikiano</h2>
          </div>
          <div class="prose prose-stone text-stone-600 font-light text-lg leading-relaxed space-y-6">
            <p>
              Mavrikiano is a hillside village above Schisma, the harbour centre of Elounda. Our ten stone houses sit within the existing village fabric, connected by stone paths and quiet lanes.
            </p>
            <p>
              The village has local places to eat and drink, including Kantouni, To Rakadiko tou Kamari, Despoina Tavern, and BeeRaki, while Elounda’s harbour, shops, local markets, and further tavernas are about a 3-minute drive away, or a 10-minute downhill walk for many guests.
            </p>
            <a href={guidePath('mavrikiano')} class="inline-flex items-center gap-2 text-stone-950 font-bold text-xs uppercase tracking-[0.2em] border-b border-stone-200 hover:border-primary transition-all pb-1 group">
              Explore the Mavrikiano Guide
              <svg class="group-hover:translate-x-1 transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </section>

        <section id="vrouchas" aria-labelledby="vrouchas-heading" class="pt-16 border-t border-stone-100">
          <div class="flex items-center gap-4 mb-6">
             <span class="text-[10px] font-bold text-primary tracking-widest uppercase">Village 02</span>
             <h2 id="vrouchas-heading" class="font-serif text-4xl text-stone-950">Vrouchas</h2>
          </div>
          <div class="prose prose-stone text-stone-600 font-light text-lg leading-relaxed space-y-6">
            <p>
              Located further north and higher in elevation, Vrouchas has a quieter hillside setting with views toward the Cretan Sea, olive groves, and the surrounding mountains. In summer, the village often feels several degrees cooler than Plaka because of its elevation and exposure.
            </p>
            <p>
              Almond Tree Villa sits within the village. About 50 metres from the house, there is a small kafeneion run by Mr Xenos, a local photographer, and his French wife. Guests can stop there for raki, small meze dishes, and simple Cretan home cooking, with one or two dishes often prepared daily by Mr Xenos’s mother.
            </p>
            <p>
              The surrounding landscape is part of the wilder northern side of Mirabello, close to protected Natura 2000 areas. A five-minute drive takes you down to the fishing village of Plaka and its waterfront tavernas.
            </p>
          </div>
        </section>

        <section id="distances" aria-labelledby="distances-heading" class="pt-16 border-t border-stone-100">
          <h2 id="distances-heading" class="font-serif text-3xl text-stone-950 mb-10">Driving Distances</h2>
          
          <div class="grid sm:grid-cols-2 gap-12">
            <div>
              <h3 class="text-[10px] uppercase tracking-[0.3em] text-primary font-bold mb-6">From Mavrikiano Houses</h3>
              <div class="space-y-4">
                {[
                  { label: 'Schisma / Elounda Harbour', value: '3 min' },
                  { label: 'Plaka', value: '7 min' },
                  { label: 'Agios Nikolaos', value: '19 min' },
                  { label: 'Heraklion Airport', value: '62 min' },
                ].map(({ label, value }) => (
                  <div class="flex justify-between items-baseline py-2 border-b border-stone-50 text-sm">
                    <span class="text-stone-400 font-light">{label}</span>
                    <span class="font-serif text-lg text-stone-900">{value}</span>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <h3 class="text-[10px] uppercase tracking-[0.3em] text-primary font-bold mb-6">From Vrouchas Villa</h3>
              <div class="space-y-4">
                {[
                  { label: 'Plaka Shoreline', value: '5 min' },
                  { label: 'Schisma / Elounda Harbour', value: '12 min' },
                  { label: 'Agios Nikolaos', value: '25 min' },
                  { label: 'Heraklion Airport', value: '75 min' },
                ].map(({ label, value }) => (
                  <div class="flex justify-between items-baseline py-2 border-b border-stone-50 text-sm">
                    <span class="text-stone-400 font-light">{label}</span>
                    <span class="font-serif text-lg text-stone-900">{value}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      </div>

      {/* SIDEBAR */}
      <aside class="lg:col-span-5 space-y-12 lg:sticky lg:top-32">
        
        {/* House Quick-List */}
        <div class="bg-stone-50 rounded-[3rem] p-10 border border-stone-100 shadow-sm">
          <h3 class="font-serif text-2xl text-stone-950 mb-8">The Collection</h3>
          <div class="space-y-8">
            {collectionGroups.map((group) => (
              <section aria-label={group.label}>
                <h4 class="mb-3 text-[9px] font-bold uppercase tracking-[0.24em] text-stone-400">{group.label}</h4>
                <ul class="space-y-4">
                  {group.slugs.map((slug) => {
                    const unit = unitBySlug.get(slug);
                    if (!unit) return null;

                    const href = unit.type === 'villa'
                      ? villaPath(unit.slug)
                      : housePath(unit.slug);

                    return (
                      <li>
                        <a href={href} class="group inline-flex max-w-full items-center gap-4 py-2 pr-2">
                          <div class="min-w-0">
                            <span class="block text-sm font-bold text-stone-900 group-hover:text-primary transition-colors">{unit.name}</span>
                            <span class="mt-2 flex flex-wrap items-center gap-1.5">
                              {collectionMetadata[unit.slug]?.map((badge) => (
                                <span class={`rounded-full border px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.14em] ${badgeStyles[badge.tone]}`}>
                                  {badge.label}
                                </span>
                              ))}
                            </span>
                          </div>
                          <div class="w-8 h-8 shrink-0 rounded-full border border-stone-200 flex items-center justify-center group-hover:bg-primary group-hover:border-primary transition-all">
                            <svg class="text-stone-400 group-hover:text-white transition-colors" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"></polyline></svg>
                          </div>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))}
          </div>
        </div>

        {/* ARRIVAL BLOCK */}
        <div class="bg-accent-sage-soft text-stone-800 border border-accent-sage/60 rounded-[3rem] p-10 shadow-premium relative overflow-hidden group">
          <div class="relative z-10">
            <h4 class="font-serif text-2xl mb-4 italic text-stone-950">A Personal Welcome</h4>
            <p class="text-sm text-stone-700 leading-relaxed mb-8 font-light">
              Navigating traditional villages can be a challenge. We personally meet all guests at our designated parking area. <strong>{siteCopy.arrival.hostName}</strong> will guide you to your home and assist with your arrival.
            </p>
            <a href={localizedPath(defaultLocale, 'contact')} class="inline-block w-full py-4 bg-accent-sage text-stone-900 text-center rounded-2xl text-[10px] font-bold uppercase tracking-[0.3em] hover:bg-accent-sage-hover hover:text-stone-900 transition-all duration-300">
              Contact Guest Relations
            </a>
          </div>
        </div>

      </aside>
    </div>

    {/* MAP SECTION */}
    <section id="map-section" class="pt-24 border-t border-stone-100">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div>
          <h2 class="font-serif text-4xl md:text-6xl text-stone-950 mb-4 tracking-tight">Village <span class="italic text-stone-400">Map</span></h2>
          <p class="text-stone-500 font-light italic">Interactive view of our properties across the Elounda hillside.</p>
        </div>
        <div class="px-6 py-2 rounded-full border border-stone-100 bg-stone-50 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400 flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
          {units.length} Properties Mapped
        </div>
      </div>
      
      <div class="rounded-[4rem] overflow-hidden shadow-premium border border-stone-200 min-h-[700px] relative bg-stone-100">
        <MasterLocationMap locations={mapMarkers} />
      </div>
    </section>

  </div>

</Base>
