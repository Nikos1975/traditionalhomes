---
import Base from '../../layouts/Base.astro';
import EloundaHotelTimeline from '../../components/blog/EloundaHotelTimeline.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(p => !p.data.draft);
  return posts.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.description ?? entry.data.subtitle ?? entry.data.title;
const category = entry.data.category ?? 'Updates';
const isLocationStyleArticle = entry.id === 'elounda-visitor-economy';
const isEloundaGuideTest = entry.id.startsWith('elounda-guide-style-');
const isEloundaGuideFamily = entry.id === 'elounda-guide' || isEloundaGuideTest;
const isLocationGreenVariant = isEloundaGuideFamily;
const guideStyleVariant = isEloundaGuideTest ? entry.id.replace('elounda-guide-', '') : null;
const titleAccentText = isLocationStyleArticle
  ? 'Changed'
  : isLocationGreenVariant
    ? 'Sea Holds Memory'
    : null;
const titleMainText = titleAccentText && entry.data.title.endsWith(titleAccentText)
  ? entry.data.title.slice(0, -titleAccentText.length).trim()
  : entry.data.title;
const blogArticleClasses = `blog-article prose prose-stone prose-lg max-w-none text-stone-700 leading-relaxed
  prose-headings:font-serif prose-headings:font-normal prose-headings:text-stone-900
  prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-6 prose-h2:border-b prose-h2:border-stone-200 prose-h2:pb-4
  prose-h3:text-xl prose-h3:mt-10
  prose-a:text-primary prose-a:font-medium prose-a:no-underline hover:prose-a:underline
  prose-strong:font-bold prose-strong:text-stone-900
  prose-img:rounded-[2rem] prose-img:shadow-premium prose-img:border prose-img:border-stone-100
  prose-blockquote:border-l-4 prose-blockquote:border-primary/20 prose-blockquote:bg-stone-50 prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:rounded-r-xl prose-blockquote:italic prose-blockquote:text-stone-600`;
const timelineArticleClasses = `${blogArticleClasses} prose-h2:scroll-mt-28`;

const pubDateFormatted = entry.data.pubDate.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<Base
  title={`${entry.data.title} | Elounda Traditional Homes`}
  description={description}
  canonicalUrl={`https://traditional-homes.gr/blog/${entry.id}/`}
  ogImage={entry.data.image}
  noindex={isEloundaGuideTest}
>
  <div class="site-max site-pad py-16 md:py-24">

    <nav class="text-[10px] uppercase tracking-[0.4em] text-stone-400 mb-12 font-bold" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2" role="list">
        <li><a href="/en/" class="hover:text-stone-900 transition-colors">Home</a></li>
        <li aria-hidden="true" class="text-stone-200">/</li>
        <li><a href="/blog/" class="hover:text-stone-900 transition-colors">Blog</a></li>
        <li aria-hidden="true" class="text-stone-200">/</li>
        <li class="min-w-0 break-words text-stone-900" aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    <div
      class:list={[
        entry.id === 'key-phases-in-elounda-hotel-development' ? 'mx-auto max-w-6xl' : 'max-w-3xl',
        !isLocationGreenVariant && entry.id !== 'key-phases-in-elounda-hotel-development' && 'mx-auto',
        (isLocationStyleArticle || isLocationGreenVariant) && 'blog-location-variant',
        isLocationGreenVariant && 'blog-location-green-variant',
        guideStyleVariant && `blog-guide-${guideStyleVariant}`,
      ]}
    >
      <header class:list={[
        'mb-12',
        (isLocationStyleArticle || isLocationGreenVariant) && 'max-w-4xl mb-20',
      ]}>
        <div class:list={[
          'flex flex-wrap items-center gap-x-3 gap-y-2 mb-4',
          (isLocationStyleArticle || isLocationGreenVariant) && 'mb-8',
        ]}>
          <time datetime={entry.data.pubDate.toISOString()} class:list={[
            'text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold',
            (isLocationStyleArticle || isLocationGreenVariant) && 'tracking-[0.4em]',
          ]}>
            {pubDateFormatted}
          </time>
          <span class="text-[10px] uppercase tracking-[0.2em] text-primary font-bold">{category}</span>
          {entry.data.region && (
            <span class="text-[10px] uppercase tracking-[0.2em] text-stone-400">{entry.data.region}</span>
          )}
        </div>
        <h1 class:list={[
          'font-serif text-4xl md:text-6xl text-stone-900 mb-3 leading-tight tracking-tight',
          (isLocationStyleArticle || isLocationGreenVariant) && 'text-5xl md:text-8xl text-stone-950 mb-8',
          isLocationGreenVariant && 'blog-title-single-line',
        ]}>
          {titleAccentText ? (
            <>
              {titleMainText}{' '}
              <span class:list={[
                'blog-title-accent italic',
                isLocationStyleArticle && 'blog-title-accent-v1',
                isLocationGreenVariant && 'blog-title-accent-v2',
              ]}>{titleAccentText}</span>
            </>
          ) : (
            entry.data.title
          )}
        </h1>
        {entry.data.subtitle && (
          <p class:list={[
            'text-xl text-stone-400 font-serif italic',
            (isLocationStyleArticle || isLocationGreenVariant) && 'text-2xl text-stone-500 font-light leading-relaxed max-w-2xl',
          ]}>{entry.data.subtitle}</p>
        )}
        {entry.data.author && (
          <p class="text-stone-400 text-sm mt-3">By {entry.data.author}</p>
        )}
        {entry.data.tags.length > 0 && (
          <div class="blog-post-tags flex flex-wrap gap-1.5 mt-4">
            {entry.data.tags.map(tag => (
              <span class="text-[9px] uppercase tracking-[0.15em] text-stone-400 bg-stone-50 px-2 py-0.5 rounded-full">{tag}</span>
            ))}
          </div>
        )}
      </header>

      {entry.id === 'key-phases-in-elounda-hotel-development' ? (
        <div class="grid gap-10 lg:grid-cols-[260px_minmax(0,42rem)] lg:items-start lg:justify-center">
          <aside class="lg:sticky lg:top-28 lg:self-start">
            <EloundaHotelTimeline />
          </aside>
          <article class={timelineArticleClasses}>
            <Content />
          </article>
        </div>
      ) : (
        <article class:list={[
          blogArticleClasses,
          (isLocationStyleArticle || isLocationGreenVariant) && 'blog-article-location-style',
          guideStyleVariant && `blog-article-${guideStyleVariant}`,
        ]}>
          <Content />
        </article>
      )}

      <div class="mt-16 pt-8 border-t border-stone-200">
        <a href="/blog/" class="group flex items-center gap-3 text-xs font-bold uppercase tracking-widest text-stone-400 hover:text-stone-900 transition-all">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:-translate-x-1 transition-transform"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back to Blog
        </a>
      </div>
    </div>

  </div>
</Base>

<style>
  .blog-article :global(> h1:first-child) {
    display: none;
  }

  .blog-article :global(> h1:first-child + p:has(> em:only-child)),
  .blog-article :global(> h1:first-child + p:has(> em:only-child) + hr) {
    display: none;
  }

  .blog-article :global(p:first-of-type::first-letter) {
    float: left;
    margin: 0.08em 0.18em 0 0;
    color: #2C2419;
    font-family: var(--font-serif);
    font-size: 5.25rem;
    font-weight: 400;
    line-height: 0.78;
  }

  .blog-article :global(> h1:first-child + p:has(> em:only-child) + hr + p::first-letter) {
    float: left;
    margin: 0.08em 0.18em 0 0;
    color: #2C2419;
    font-family: var(--font-serif);
    font-size: 5.25rem;
    font-weight: 400;
    line-height: 0.78;
  }

  .blog-location-variant :global(time),
  .blog-location-variant :global(header span:not(.text-primary)) {
    color: #C8BFB0;
  }

  .blog-location-green-variant :global(time),
  .blog-location-green-variant :global(header span:not(.text-primary)),
  .blog-location-green-variant :global(.text-stone-400) {
    color: #98BCB4;
  }

  .blog-article-location-style {
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .blog-article-location-style :global(p),
  .blog-article-location-style :global(li) {
    color: #6B5F50;
    font-weight: 300;
    line-height: 1.75;
  }

  .blog-article-location-style :global(h2) {
    margin-top: 5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #F7F4EE;
    padding-bottom: 1rem;
    color: #2C2419;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .blog-article-location-style :global(h3) {
    margin-top: 3.5rem;
    color: #2C2419;
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .blog-article-location-style :global(figure) {
    margin-top: 3rem;
    margin-bottom: 4rem;
  }

  .blog-article-location-style :global(figcaption) {
    color: #6B5F50;
    font-size: 0.8rem;
    font-style: italic;
    font-weight: 300;
  }

  .blog-location-green-variant .blog-article-location-style :global(h2) {
    border-bottom-color: #E7F0ED;
  }

  .blog-location-green-variant > header {
    margin-bottom: 5rem;
  }

  .blog-title-accent {
    font-family: "Cormorant Garamond", Georgia, Cambria, serif;
    font-style: italic;
    letter-spacing: 0;
  }

  .blog-title-accent-v1 {
    color: rgb(154, 143, 126);
    font-size: 24px;
    font-weight: 300;
    line-height: 39px;
    vertical-align: baseline;
  }

  .blog-title-accent-v2 {
    color: rgb(152, 188, 180);
    font-weight: 400;
  }

  .blog-location-green-variant > header > p {
    color: rgb(154, 143, 126);
    font-size: 24px;
    line-height: 1.625;
    max-width: 42rem;
  }

  .blog-location-green-variant .blog-post-tags :global(span) {
    color: rgb(107, 95, 80);
  }

  .blog-article-style-1 :global(hr) {
    border: 0;
    margin: 4rem 0;
  }

  .blog-article-style-2 :global(hr) {
    border: 0;
    border-top: 1px solid #E6E1D8;
    margin: 4.5rem 0;
  }

  .blog-article-style-3 :global(hr) {
    width: 4rem;
    border: 0;
    border-top: 1px solid #C8BFB0;
    margin: 4.5rem 0;
  }

  .blog-article-style-3 :global(hr::after) {
    content: "";
    display: block;
    width: 0.375rem;
    height: 0.375rem;
    margin-top: -0.21875rem;
    margin-left: 4.75rem;
    border-radius: 9999px;
    background: #98BCB4;
  }

  .blog-title-single-line {
    font-size: 2rem;
    line-height: 1.05;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .blog-title-single-line {
      font-size: 3.25rem;
    }
  }

  @media (min-width: 768px) {
    .blog-title-single-line {
      font-size: 4.5rem;
    }
  }

  .blog-article :global(img) {
    transition: transform 10s ease-out;
  }

  .blog-article :global(figure) {
    position: relative;
    overflow: hidden;
    border-radius: 2rem;
    background: #e7e5e4;
  }

  .blog-article :global(figure::after) {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(0 0 0 / 0);
    pointer-events: none;
    transition: background-color 500ms ease;
  }

  .blog-article :global(figure:hover img) {
    transform: scale(1.05);
  }

  .blog-article :global(figure:hover::after) {
    background: rgb(0 0 0 / 0.1);
  }

  .blog-article :global(figcaption) {
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .blog-article :global(p:first-of-type::first-letter) {
      font-size: 7.5rem;
      margin-right: 0.24em;
    }

    .blog-article :global(> h1:first-child + p:has(> em:only-child) + hr + p::first-letter) {
      font-size: 7.5rem;
      margin-right: 0.24em;
    }
  }
</style>
