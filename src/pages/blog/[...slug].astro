---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import siteCopy from '../../data/siteCopy.json';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(p => !p.data.draft);
  return posts.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const description = entry.data.description ?? entry.data.subtitle ?? entry.data.title;
const category = entry.data.category ?? 'Updates';
const leadImageCaption = entry.data.imageCaption ?? entry.data.imageAlt;
const leadImageCredit = entry.data.imageCredit;
const leadImageCreditUrl = entry.data.imageCreditUrl;
const isEloundaGuideTest = entry.id.startsWith('elounda-guide-style-');
const hasMarkdownSubtitle = entry.id === 'elounda-guide' || isEloundaGuideTest;
const guideStyleVariant = isEloundaGuideTest ? entry.id.replace('elounda-guide-', '') : null;
const blogArticleClasses = `blog-article prose prose-stone prose-lg max-w-none text-stone-700
  prose-headings:font-serif prose-headings:font-normal prose-headings:text-stone-900
  prose-p:my-6 prose-p:leading-8
  prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-5 prose-h2:leading-snug
  prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-3 prose-h3:leading-snug
  prose-a:text-primary prose-a:font-medium prose-a:no-underline hover:prose-a:underline
  prose-strong:font-bold prose-strong:text-stone-900
  prose-ul:my-6 prose-ol:my-6 prose-li:my-2 prose-li:leading-8
  prose-hr:my-10 prose-hr:border-stone-200
  prose-img:rounded-md prose-img:border prose-img:border-stone-200 prose-img:shadow-none
  prose-figcaption:mt-3 prose-figcaption:text-sm prose-figcaption:leading-relaxed prose-figcaption:text-stone-500 prose-figcaption:not-italic
  prose-blockquote:border-l-2 prose-blockquote:border-stone-300 prose-blockquote:bg-stone-50 prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:not-italic prose-blockquote:text-stone-700`;

const pubDateFormatted = entry.data.pubDate.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const articleHeadings = headings.filter(heading =>
  heading.depth === 2 && !/^sources( and image credits)?$/i.test(heading.text.trim())
);
const showToc = articleHeadings.length >= 4;

const relatedPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft && !post.id.startsWith('elounda-guide-style-') && post.id !== entry.id)
  .sort((a, b) => {
    const sameCategoryA = (a.data.category ?? 'Updates') === category ? 0 : 1;
    const sameCategoryB = (b.data.category ?? 'Updates') === category ? 0 : 1;
    if (sameCategoryA !== sameCategoryB) return sameCategoryA - sameCategoryB;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);
---

<Base
  title={`${entry.data.title} | Elounda Traditional Homes`}
  description={description}
  canonicalUrl={`https://traditional-homes.gr/blog/${entry.id}/`}
  ogImage={entry.data.image}
  noindex={isEloundaGuideTest}
>
  <div class="site-pad py-12 md:py-20">
    <div class="mx-auto max-w-[46rem]">

      <nav class="mb-10 text-sm text-stone-500" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1" role="list">
          <li><a href="/en/" class="hover:text-stone-900 transition-colors">Home</a></li>
          <li aria-hidden="true" class="text-stone-300">/</li>
          <li><a href="/blog/" class="hover:text-stone-900 transition-colors">Blog</a></li>
          <li aria-hidden="true" class="text-stone-300">/</li>
          <li class="min-w-0 break-words text-stone-800" aria-current="page">{entry.data.title}</li>
        </ol>
      </nav>

      <header class="mb-10 border-b border-stone-200 pb-8">
        <div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-stone-500">
          <time datetime={entry.data.pubDate.toISOString()}>{pubDateFormatted}</time>
          <span aria-hidden="true" class="text-stone-300">/</span>
          <span class="font-medium text-stone-700">{category}</span>
          {entry.data.region && (
            <>
              <span aria-hidden="true" class="text-stone-300">/</span>
              <span>{entry.data.region}</span>
            </>
          )}
        </div>
        <h1 class="mb-4 font-serif text-4xl leading-tight text-stone-900 md:text-5xl">
          {entry.data.title}
        </h1>
        {entry.data.subtitle && (
          <p class="text-lg leading-8 text-stone-600 md:text-xl">{entry.data.subtitle}</p>
        )}
        {entry.data.author && (
          <p class="mt-4 text-sm text-stone-500">By {entry.data.author}</p>
        )}
        {entry.data.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {entry.data.tags.map(tag => (
              <span class="rounded border border-stone-200 bg-stone-50 px-2 py-1 text-xs text-stone-500">{tag}</span>
            ))}
          </div>
        )}
      </header>

      {entry.data.image && (
        <figure class="blog-lead-image mb-12">
          <div class="overflow-hidden rounded-xl border border-stone-200 bg-stone-100">
            <img
              src={entry.data.image}
              alt={entry.data.imageAlt ?? ''}
              loading="eager"
              class="h-full w-full object-cover"
            />
          </div>
          {(leadImageCaption || leadImageCredit) && (
            <figcaption class="mt-3 text-sm leading-relaxed text-stone-500">
              {leadImageCaption && <span>{leadImageCaption}</span>}
              {leadImageCredit && (
                <>
                  {leadImageCaption && ' '}
                  {leadImageCreditUrl ? (
                    <a href={leadImageCreditUrl} class="text-stone-600 underline decoration-stone-300 underline-offset-2 hover:text-stone-900" rel="noopener noreferrer" target="_blank">
                      {leadImageCredit}
                    </a>
                  ) : (
                    <span>{leadImageCredit}</span>
                  )}
                </>
              )}
            </figcaption>
          )}
        </figure>
      )}

      {showToc && (
        <nav class="mb-12 border-y border-stone-200 py-5" aria-labelledby="article-toc-heading">
          <h2 id="article-toc-heading" class="mb-3 text-sm font-semibold text-stone-900">In this article</h2>
          <ol class="space-y-2 text-sm leading-6 text-stone-600" role="list">
            {articleHeadings.map(heading => (
              <li>
                <a href={`#${heading.slug}`} class="hover:text-stone-900 hover:underline">{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <article class:list={[
        blogArticleClasses,
        hasMarkdownSubtitle && 'blog-article-has-markdown-subtitle',
        guideStyleVariant && `blog-article-${guideStyleVariant}`,
      ]}>
        <Content />
      </article>

      <aside data-blog-availability-cta class="mt-14 border border-stone-200 bg-stone-50 p-6 sm:p-8" aria-labelledby="blog-availability-heading">
        <h2 id="blog-availability-heading" class="font-serif text-2xl text-stone-900">Planning a stay in Elounda?</h2>
        <p class="mt-3 max-w-2xl leading-7 text-stone-600">See the traditional houses in Mavrikiano and Vrouchas, or check current availability.</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/en/houses/" class="inline-flex items-center justify-center border border-stone-300 px-5 py-3 text-sm font-medium text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900">
            View the houses
          </a>
          <a href={siteCopy.bookingEngineUrl} target="_blank" rel="noopener noreferrer" class="btn-cta booking-cta inline-flex items-center justify-center px-5 py-3 text-sm">
            Check availability
          </a>
        </div>
      </aside>

      {relatedPosts.length > 0 && (
        <section class="mt-16 border-t border-stone-200 pt-8" aria-labelledby="related-reading-heading">
          <h2 id="related-reading-heading" class="mb-5 font-serif text-2xl text-stone-900">Related Reading</h2>
          <ul class="divide-y divide-stone-200" role="list">
            {relatedPosts.map(post => (
              <li class="py-4 first:pt-0">
                <a href={`/blog/${post.id}/`} class="group block">
                  <span class="mb-1 block text-sm text-stone-500">
                    {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                    {' / '}
                    {post.data.category ?? 'Updates'}
                  </span>
                  <span class="block text-base font-medium text-stone-900 group-hover:text-primary">{post.data.title}</span>
                  {post.data.description && (
                    <span class="mt-1 block text-sm leading-6 text-stone-600">{post.data.description}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="mt-10 border-t border-stone-200 pt-8">
        <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 hover:text-stone-900 transition-colors">
          <span aria-hidden="true">&larr;</span>
          <span>Back to Blog</span>
        </a>
      </div>
    </div>

  </div>
</Base>

<style>
  .blog-article :global(> h1:first-child) {
    display: none;
  }

  .blog-article :global(> h1:first-child + p:has(> em:only-child)),
  .blog-article :global(> h1:first-child + p:has(> em:only-child) + hr) {
    display: none;
  }

  .blog-article :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
  }

  .blog-lead-image {
    width: min(calc(100vw - 2rem), 64rem);
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .blog-lead-image img {
    aspect-ratio: 16 / 9;
    display: block;
    max-height: 34rem;
  }

  .blog-article :global(p:first-of-type::first-letter) {
    float: left;
    margin: 0.08em 0.16em 0 0;
    color: #2C2419;
    font-family: var(--font-serif);
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 0.82;
  }

  .blog-article-has-markdown-subtitle :global(> h1:first-child + p:has(> em:only-child) + hr + p::first-letter) {
    float: left;
    margin: 0.08em 0.16em 0 0;
    color: #2C2419;
    font-family: var(--font-serif);
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 0.82;
  }

  .blog-article-style-1 :global(hr) {
    border: 0;
    margin: 4rem 0;
  }

  .blog-article-style-2 :global(hr) {
    border: 0;
    border-top: 1px solid #E6E1D8;
    margin: 4.5rem 0;
  }

  .blog-article-style-3 :global(hr) {
    width: 4rem;
    border: 0;
    border-top: 1px solid #C8BFB0;
    margin: 4.5rem 0;
  }

  .blog-article-style-3 :global(hr::after) {
    content: "";
    display: block;
    width: 0.375rem;
    height: 0.375rem;
    margin-top: -0.21875rem;
    margin-left: 4.75rem;
    border-radius: 9999px;
    background: #98BCB4;
  }

  .blog-article :global(img) {
    display: block;
    height: auto;
    width: 100%;
    transition: transform 10s ease-out;
  }

  .blog-article :global(figure) {
    position: relative;
    overflow: hidden;
    margin: 2.5rem 0 3rem;
    border-radius: 0.75rem;
    background: #f5f5f4;
  }

  .blog-article :global(figure::after) {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(0 0 0 / 0);
    pointer-events: none;
    transition: background-color 500ms ease;
  }

  .blog-article :global(figure:hover img) {
    transform: scale(1.025);
  }

  .blog-article :global(figure:hover::after) {
    background: rgb(0 0 0 / 0.04);
  }

  .blog-article :global(figcaption) {
    position: relative;
    z-index: 2;
    padding: 0 0.25rem;
  }

  @media (min-width: 768px) {
    .blog-article :global(p:first-of-type::first-letter) {
      font-size: 5.75rem;
      margin-right: 0.2em;
    }

    .blog-article-has-markdown-subtitle :global(> h1:first-child + p:has(> em:only-child) + hr + p::first-letter) {
      font-size: 5.75rem;
      margin-right: 0.2em;
    }
  }

  @media (max-width: 520px) {
    .blog-article :global(p:first-of-type::first-letter),
    .blog-article-has-markdown-subtitle :global(> h1:first-child + p:has(> em:only-child) + hr + p::first-letter) {
      font-size: 3.75rem;
      margin-right: 0.14em;
    }
  }
</style>
